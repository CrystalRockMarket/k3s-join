# /etc/k3s-earn/earn.env — root:root 0600 or root:k3s-earn 0640.
# Names only; never commit values.
EARN_DATA=/var/lib/k3s-earn
EARN_DB=/var/lib/k3s-earn/earn.db
EARN_SECRET_KEY=
EARN_FERNET_KEY=
EARN_PUBLIC_ORIGIN=https://k3s.kituwa.com
EARN_RP_ID=k3s.kituwa.com
EARN_RP_NAME=Kituwa Cluster
EARN_COOKIE_SECURE=true
EARN_POINTS_SNAPSHOT=/var/www/k3s.kituwa.com/points/points.json
EARN_WELCOME_POINTS=500
EARN_TRUST_PROXY=true
EARN_SMTP_HOST=mail.kituwa.com
EARN_SMTP_PORT=465
EARN_SMTP_USER=admin@kituwa.com
EARN_SMTP_PASSWORD=
EARN_SMTP_FROM="Kituwa Cluster <admin@kituwa.com>"
EARN_SMTP_REPLY_TO=support@kituwa.com
EARN_SMTP_TLS=false
EARN_SMTP_SSL=true
EARN_OIDC_ISSUER=https://auth.kituwa.com
EARN_OIDC_CLIENT_ID=
EARN_OIDC_CLIENT_SECRET=
EARN_OIDC_REDIRECT_URI=https://k3s.kituwa.com/admin/oidc/callback
EARN_OIDC_CONSUMER_CLIENT_ID=
EARN_OIDC_CONSUMER_CLIENT_SECRET=
EARN_OIDC_CONSUMER_REDIRECT_URI=https://k3s.kituwa.com/account/oidc/callback
EARN_OIDC_ALLOWED_GROUP=operators
EARN_OIDC_ALLOWED_SUB=
